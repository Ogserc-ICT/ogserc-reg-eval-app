# Postgres: docker-compose (npm run db:up) listens on 5432; the embedded fallback (npm run db:embedded) on 5433.
DATABASE_URL="postgresql://ogserc:ogserc@localhost:5432/ogserc?schema=public"

# Auth.js secret: generate with `npx auth secret` or `openssl rand -base64 32`. Required in production.
AUTH_SECRET=""

# First admin, created by `npm run db:seed` if the email does not exist yet (no public sign-up).
SEED_ADMIN_EMAIL="admin@ogserc.gov.ng"
SEED_ADMIN_PASSWORD=""

# Daily review cron (POST /api/cron/daily-review with "Authorization: Bearer <secret>"). At least 32 characters.
CRON_SECRET=""

# Public base URL of the app. Certificate QR codes link to APP_URL/verify/... Required in production.
APP_URL=""
