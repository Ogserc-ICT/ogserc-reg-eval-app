# Production settings for deploy/docker-compose.yml. Copy to deploy/.env and fill in every value.
# Keep deploy/.env private: chmod 600 deploy/.env. Generate secrets with:  openssl rand -base64 48
# (POSTGRES_PASSWORD: use  openssl rand -hex 32  - it goes inside a URL, where / or + would break it)

# --- Address ---------------------------------------------------------------------------------------
# The name staff type in the browser. Any domain you control (e.g. portal.example.com.ng), or a free
# IP-based name such as 203-0-113-5.sslip.io. See docs/DEPLOYMENT.md, "Choosing an address".
APP_DOMAIN=
# Let's Encrypt account email (certificate expiry warnings). Optional.
ACME_EMAIL=
# "public" runs Caddy for HTTPS on ports 80/443. Leave empty for the private-network setup
# (Tailscale), where the app is published on APP_BIND only.
COMPOSE_PROFILES=public
# Where the app listens on the VPS itself. Loopback only; Caddy or Tailscale publish it.
APP_BIND=127.0.0.1:3000
# Only for the private-network setup: the full URL staff use (certificate QR codes link to it).
# Defaults to https://APP_DOMAIN.
# APP_URL=https://ogserc.tailnet-name.ts.net

# --- Secrets -----------------------------------------------------------------------------------------
POSTGRES_PASSWORD=
AUTH_SECRET=
# Used by the scheduler to run the 06:00 daily review. At least 32 characters.
CRON_SECRET=

# --- First admin (created on first start; ignored once the account exists) -------------------------
# Refused if weak or a default. Change it after first sign-in; then you may remove both lines.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# --- Backups -----------------------------------------------------------------------------------------
# Encrypts every backup. At least 20 characters. Store a copy OFF the server (e.g. in a password
# manager): without it no backup can be restored.
BACKUP_PASSPHRASE=
# Folder on the VPS for the backup files (relative to deploy/).
BACKUP_DIR=./backups
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_WEEKLY=8
# Off-site copy: the rclone remote and folder, e.g. offsite:ogserc-backups. Credentials go in
# deploy/offsite.env (see offsite.env.example). Leave empty to keep backups on this server only.
RCLONE_REMOTE=
