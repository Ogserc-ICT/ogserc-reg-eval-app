# Credentials for the off-site backup copy. Copy to deploy/offsite.env (chmod 600) and keep ONE block.
# Then set RCLONE_REMOTE=offsite:<bucket-name> in deploy/.env. The remote is named "offsite" below.
# Use a key that can only write to that one bucket, and turn on the bucket's lifecycle rule to delete
# files older than, say, 90 days.

# --- Backblaze B2 (low cost) ---
RCLONE_CONFIG_OFFSITE_TYPE=b2
RCLONE_CONFIG_OFFSITE_ACCOUNT=
RCLONE_CONFIG_OFFSITE_KEY=

# --- Any S3-compatible storage (AWS S3, Wasabi, Cloudflare R2, DigitalOcean Spaces…) ---
# RCLONE_CONFIG_OFFSITE_TYPE=s3
# RCLONE_CONFIG_OFFSITE_PROVIDER=AWS
# RCLONE_CONFIG_OFFSITE_ACCESS_KEY_ID=
# RCLONE_CONFIG_OFFSITE_SECRET_ACCESS_KEY=
# RCLONE_CONFIG_OFFSITE_REGION=eu-west-1
# RCLONE_CONFIG_OFFSITE_ENDPOINT=

# --- Google Drive (no lifecycle rules: set BACKUP_OFFSITE_KEEP_DAILY_DAYS / _WEEKLY_DAYS instead) ---
# Token from: rclone authorize "drive" "eyJzY29wZSI6ImRyaXZlLmZpbGUifQ" (docs/DEPLOYMENT-VERCEL.md)
# RCLONE_CONFIG_OFFSITE_TYPE=drive
# RCLONE_CONFIG_OFFSITE_SCOPE=drive.file
# RCLONE_CONFIG_OFFSITE_TOKEN=
