// OGSERC Registration & Evaluation — data model (SPEC §1).
// Money: BigInt kobo. Legal dates: @db.Date (no time). Never delete Submission, Payment or AuditLog
// rows (enforced by triggers in the init migration).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Users, roles and Auth.js tables
// ---------------------------------------------------------------------------

/// SPEC §5. A user may hold several roles.
enum Role {
  REGISTRY_OFFICER
  FINANCE_OFFICER
  EVALUATING_OFFICER
  REVIEWING_SUPERVISOR
  APPROVING_OFFICER
  ADMIN
  VIEWER
}

model User {
  id                String    @id @default(cuid())
  name              String
  email             String    @unique
  emailVerified     DateTime?
  image             String?
  passwordHash      String
  // Login throttling (src/server/login-throttle.ts)
  failedLoginCount  Int       @default(0)
  lastFailedLoginAt DateTime?
  lockedUntil       DateTime?
  roles             Role[]
  active            Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  accounts Account[]
  sessions Session[]

  auditLogs               AuditLog[]
  deficiencyNoticesIssued DeficiencyNotice[]
  documentsGenerated      GeneratedDocument[]
  submissionsCreated      Submission[]         @relation("SubmissionCreatedBy")
  evaluationsAsEvaluator  Evaluation[]         @relation("EvaluatingOfficer")
  evaluationsAsReviewer   Evaluation[]         @relation("ReviewingSupervisor")
  evaluationsAsApprover   Evaluation[]         @relation("ApprovingOfficer")
  paymentsRecorded        Payment[]            @relation("PaymentRecordedBy")
  paymentsVerified        Payment[]            @relation("PaymentVerifiedBy")
  paymentsFinanceDecided  Payment[]            @relation("PaymentFinanceDecidedBy")
  paymentsReversed        Payment[]            @relation("PaymentReversedBy")
  ownUseCreated           OwnUseNotification[]
  workbooksUploaded       WorkbookImport[]     @relation("WorkbookUploadedBy")
  workbooksImported       WorkbookImport[]     @relation("WorkbookImportedBy")
  notifications           Notification[]
  categoriesConfirmed     Submission[]         @relation("CategoryConfirmedBy")
  ownUseRegistered        OwnUseNotification[] @relation("OwnUseRegisteredBy")
}

// Required by @auth/prisma-adapter; unused while sign-in is email + password only.
model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

/// The cookie holds a random token; only its SHA-256 is stored (src/server/session-store.ts).
model Session {
  tokenHash String   @unique
  userId    String
  expires   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ---------------------------------------------------------------------------
// Settings and reference data (seeded from seed-data.json)
// ---------------------------------------------------------------------------

/// SPEC §1.7: single row, id = 1.
model Settings {
  id                           Int               @id @default(1)
  effectiveDate                DateTime          @db.Date
  registrationPeriodDays       Int
  extensionDays                Int
  newOperatorLeadDays          Int
  determinationDays            Int
  deficiencyDays               Int
  licenceApplicationDays       Int
  licenceExpiryWindowDays      Int
  amberWarningDays             Int
  ownUseThresholdKw            Int
  showCauseDays                Int               @default(14)
  registrationPrefix           String
  ackPrefix                    String
  ounPrefix                    String
  paymentPrefix                String
  chairmanName                 String
  commissionerName             String
  /// §8.9: stored once here.
  feesRevisedOn                DateTime?         @db.Date
  // §9 open questions, configurable until the Commission decides.
  lateChargeBlocksCompleteness Boolean           @default(false)
  waiverAppliesToLateCharge    Boolean           @default(false)
  flagsBlockApproval           Boolean           @default(false)
  tinPattern                   String?
  /// Finance gate: when on, confirmed payments must cover the total due (incl. late charge), not
  /// just fee − waiver, before a submission is released for evaluation.
  lateChargeRequiredForRelease Boolean           @default(false)
  /// Days after acknowledgement before an unpaid submission is marked "reminder due" on the
  /// dashboard queue. Null = no reminder.
  unpaidReminderDays           Int?
  // Open policy points for the category forms REG-01A–K (docs/DECISIONS.md); changes are audited.
  /// Category of Supply / retail at 1 MW or more.
  supplyRetailCategory1MwPlus  String            @default("K")
  wrongFormHandling            WrongFormHandling @default(ACCEPT)
  /// Other activities ticked also require their own form's documents.
  otherActivitiesRequireDocs   Boolean           @default(false)
  /// Own-use notifications (REG-01I) can be registered with a certificate.
  ownUseCertificate            Boolean           @default(false)
  /// Updates and annual confirmations pay the category's registration fee.
  filingFeeOnUpdates           Boolean           @default(false)
  /// Annual confirmation due date each year, "MM-DD" (para 16(2)).
  annualConfirmationDue        String            @default("01-31")
  updatedAt                    DateTime          @updatedAt
}

enum WrongFormHandling {
  /// Accept a submission on the wrong form; the evaluator re-categorises it with a reason.
  ACCEPT
  /// The applicant must file on the right form (check 1.10 fails; deficiency notice).
  REQUIRE_CORRECT_FORM
}

/// Schedule 3 fee table.
model FeeCategory {
  category        String  @id
  registrationFee BigInt
  lateInitial     BigInt
  lateDaily       BigInt
  lateDailyCap    BigInt
  lateTier        String?
  description     String

  activities10MwPlus Activity[]   @relation("Cat10MwPlus")
  activities1To10Mw  Activity[]   @relation("Cat1To10Mw")
  activitiesBelow1Mw Activity[]   @relation("CatBelow1Mw")
  overrides          Submission[]
}

/// Activity → category map.
model Activity {
  code          String  @id
  name          String  @unique
  cat10MwPlus   String
  cat1To10Mw    String
  catBelow1Mw   String
  capacityBased Boolean
  sortOrder     Int

  category10MwPlus FeeCategory          @relation("Cat10MwPlus", fields: [cat10MwPlus], references: [category])
  category1To10Mw  FeeCategory          @relation("Cat1To10Mw", fields: [cat1To10Mw], references: [category])
  categoryBelow1Mw FeeCategory          @relation("CatBelow1Mw", fields: [catBelow1Mw], references: [category])
  primaryFor       Submission[]         @relation("PrimaryActivity")
  otherFor         SubmissionActivity[]
}

model Lga {
  name      String @id
  sortOrder Int
}

/// Drop-down lists (registrant types, licence statuses, fuels, channels, payment purposes).
model LookupValue {
  list      String
  value     String
  sortOrder Int

  @@id([list, value])
}

/// Registration forms REG-01A to REG-01K (registration-forms.json); REG-01I is the own-use form.
model RegistrationForm {
  form      String @id
  category  String @unique
  title     String
  para      String
  sortOrder Int

  documents   FormDocument[]
  submissions Submission[]
}

/// A form's Schedule 2 documents. `key` is shared across forms (the same document on each).
model FormDocument {
  form         String
  key          String
  text         String
  /// Condition (registration-forms.json `document_conditions`) under which the item applies.
  requiredWhen String?
  sortOrder    Int

  registrationForm RegistrationForm @relation(fields: [form], references: [form])

  @@id([form, key])
}

/// Form EVAL-01 checks (55 decision + 7 post-approval).
model EvaluationCheck {
  id        String @id
  stage     String
  text      String
  sortOrder Int

  values EvaluationCheckValue[]
}

/// Number sequences (ACK, PAY, OUN, REG:{year}). Incremented inside the saving transaction.
model Counter {
  name  String @id
  value Int    @default(0)
}

// ---------------------------------------------------------------------------
// Register
// ---------------------------------------------------------------------------

enum SubmissionStatus {
  /// First status (Finance confirmation gate): acknowledged, waiting for Finance to confirm payment.
  AWAITING_PAYMENT @map("Acknowledged - Awaiting Payment")
  RECEIVED         @map("Received - Under Review")
  DEFICIENCY       @map("Deficiency Notice Issued")
  PROVISIONAL      @map("Provisionally Registered")
  REGISTERED       @map("Registered")
  LAPSED           @map("Lapsed")
  REFUSED          @map("Refused")
  CANCELLED        @map("Cancelled")
  /// An update or annual confirmation approved and applied to its registered record (para 16).
  APPLIED          @map("Changes Applied")
}

/// What a submission is (registration-forms.json `filing_types`).
enum FilingType {
  NEW    @map("New registration")
  /// Material change, para 16(1).
  UPDATE @map("Update: material change")
  /// Para 16(2).
  ANNUAL @map("Annual confirmation")
}

enum CheckValue {
  Y
  N
  NA @map("N/A")
}

/// SPEC §1.1: one per registrant, plus one per update or annual confirmation filed against it.
model Submission {
  id     String @id @default(cuid())
  ackSeq Int    @unique
  ackNo  String @unique

  filingType         FilingType @default(NEW)
  /// Form the applicant used (REG-01A to K).
  formFiled          String
  /// Updates and annual confirmations: the registered submission they apply to.
  linkedSubmissionId String?

  registeredName     String
  tradingName        String?
  dateSubmitted      DateTime  @db.Date
  submissionChannel  String?
  registrantType     String?
  cacNo              String?
  incorporationDate  DateTime? @db.Date
  tin                String?
  address            String?
  /// Operational address in Ogun State.
  operationalAddress String?
  website            String?
  principalLga       String
  /// Every LGA served (multi-select of the LGA list).
  lgasServed         String[]  @default([])
  /// Towns, communities, estates or industrial clusters served.
  otherAreasServed   String?

  primaryActivityCode String
  installedCapacityMw Decimal? @db.Decimal(12, 4)
  customers           Int?

  licenceStatus String

  /// Managing director / principal officer.
  mdName            String?
  mdPhone           String?
  mdEmail           String?
  /// Regulatory compliance officer, with `phone` and `email`.
  complianceOfficer String?
  phone             String?
  email             String?

  /// Declaration: two signatories (Schedule 1).
  signatory1Name        String?
  signatory1Designation String?
  signatory1Date        DateTime? @db.Date
  signatory2Name        String?
  signatory2Designation String?
  signatory2Date        DateTime? @db.Date

  // Document conditions (registration-forms.json `document_conditions`): null = not answered.
  holdsAnyLicence        Boolean?
  multiStateLicensee     Boolean?
  generationForSale      Boolean?
  gridConnected          Boolean?
  interconnectedMinigrid Boolean?
  fDistribution          Boolean?
  fTrading               Boolean?
  gDiscoBulkSupply       Boolean?
  subFranchise           Boolean?

  /// Answers to the category-specific sections, by form (technical-sections.json), validated by
  /// src/domain/technical.ts. Money in kobo; other numbers in the unit printed on the form.
  technicalData Json @default("{}")

  operatingOnEffectiveDate Boolean
  plannedStartDate         DateTime? @db.Date

  approvedWaiver   BigInt  @default(0)
  categoryOverride String?
  overrideReason   String?

  /// "Category confirmed" by the evaluator (official-use box), with a reason when it differs from
  /// the form filed.
  confirmedCategory       String?
  categoryConfirmedReason String?
  categoryConfirmedById   String?
  categoryConfirmedOn     DateTime? @db.Date

  status                    SubmissionStatus @default(AWAITING_PAYMENT)
  /// Set when confirmed payments first cleared the Finance gate (status → Received - Under Review).
  releasedForEvaluationDate DateTime?        @db.Date
  dateSubmissionComplete    DateTime?        @db.Date
  deficiencyNoticeDate      DateTime?        @db.Date
  showCauseDate             DateTime?        @db.Date
  certificateIssueDate      DateTime?        @db.Date
  /// Locked once issued; never changes afterwards.
  registrationNo            String?          @unique
  remarks                   String?
  /// Set when Admin changes a field printed on the certificate of a Registered record (Phase 5 reissues).
  certificateNeedsReissue   Boolean          @default(false)

  // Pricing snapshot, taken when the submission is saved. Later edits to the fee table or Settings
  // never change it; only an admin recalculation does (trigger-enforced; src/server/pricing.ts).
  pricedCategory        String
  pricedRegistrationFee BigInt
  pricedLateInitial     BigInt
  pricedLateDaily       BigInt
  pricedLateDailyCap    BigInt
  pricedDeadline        DateTime? @db.Date
  pricedEffectiveDate   DateTime  @db.Date
  pricedAt              DateTime  @default(now())

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy             User                        @relation("SubmissionCreatedBy", fields: [createdById], references: [id])
  categoryConfirmedBy   User?                       @relation("CategoryConfirmedBy", fields: [categoryConfirmedById], references: [id])
  form                  RegistrationForm            @relation(fields: [formFiled], references: [form])
  linkedSubmission      Submission?                 @relation("LinkedFilings", fields: [linkedSubmissionId], references: [id], onDelete: Restrict)
  linkedFilings         Submission[]                @relation("LinkedFilings")
  primaryActivity       Activity                    @relation("PrimaryActivity", fields: [primaryActivityCode], references: [code])
  otherActivities       SubmissionActivity[]
  licences              SubmissionLicence[]
  shareholders          SubmissionShareholder[]
  directors             SubmissionDirector[]
  confidentialityClaims SubmissionConfidentiality[]
  hseIncidents          SubmissionHseIncident[]
  override              FeeCategory?                @relation(fields: [categoryOverride], references: [category])
  documents             DocumentChecklistItem[]
  evaluation            Evaluation?
  payments              Payment[]
  deficiencyNotices     DeficiencyNotice[]
  generatedDocuments    GeneratedDocument[]

  @@index([cacNo])
  @@index([status])
  @@index([registeredName])
  @@index([linkedSubmissionId])
}

/// Other activities ticked (Schedule 1 "Other activities"); highest category applies (para 17(1)).
model SubmissionActivity {
  submissionId String
  activityCode String
  sortOrder    Int

  submission Submission @relation(fields: [submissionId], references: [id])
  activity   Activity   @relation(fields: [activityCode], references: [code])

  @@id([submissionId, activityCode])
}

/// Licences, permits and registrations held (Schedule 1 C). Licence flags use the nearest expiry.
model SubmissionLicence {
  id               String    @id @default(cuid())
  submissionId     String
  sortOrder        Int
  type             String?
  issuingAuthority String?
  number           String?
  issueDate        DateTime? @db.Date
  expiryDate       DateTime? @db.Date
  activityCovered  String?

  submission Submission @relation(fields: [submissionId], references: [id])

  @@index([submissionId])
}

/// Shareholders or members holding 5% or more (Schedule 1 B).
model SubmissionShareholder {
  id              String   @id @default(cuid())
  submissionId    String
  sortOrder       Int
  name            String
  nationality     String?
  percentHolding  Decimal? @db.Decimal(5, 2)
  beneficialOwner Boolean?

  submission Submission @relation(fields: [submissionId], references: [id])

  @@index([submissionId])
}

/// Directors and key officers (Schedule 1 B).
model SubmissionDirector {
  id           String  @id @default(cuid())
  submissionId String
  sortOrder    Int
  name         String
  position     String?
  phone        String?
  email        String?

  submission Submission @relation(fields: [submissionId], references: [id])

  @@index([submissionId])
}

/// Information claimed as commercially sensitive, with reasons (para 15(3)).
model SubmissionConfidentiality {
  id           String  @id @default(cuid())
  submissionId String
  sortOrder    Int
  item         String
  reasons      String?

  submission Submission @relation(fields: [submissionId], references: [id])

  @@index([submissionId])
}

/// HSE incidents in the last 24 months.
model SubmissionHseIncident {
  id           String    @id @default(cuid())
  submissionId String
  sortOrder    Int
  date         DateTime? @db.Date
  location     String?
  /// Incident, fatality, or outage over 24 hours.
  type         String?
  description  String?

  submission Submission @relation(fields: [submissionId], references: [id])

  @@index([submissionId])
}

/// Each deficiency notice (para 13(1)(b)). A new one may be issued once the previous is resolved.
model DeficiencyNotice {
  id                   String    @id @default(cuid())
  submissionId         String
  seq                  Int
  noticeRef            String    @unique
  noticeDate           DateTime  @db.Date
  responseDue          DateTime  @db.Date
  /// Date the response completed the submission; null while outstanding (or if it lapsed).
  responseReceivedDate DateTime? @db.Date
  issuedById           String
  createdAt            DateTime  @default(now())

  submission Submission          @relation(fields: [submissionId], references: [id])
  issuedBy   User                @relation(fields: [issuedById], references: [id])
  documents  GeneratedDocument[]

  @@unique([submissionId, seq])
}

enum DocumentKind {
  ACKNOWLEDGEMENT
  EVALUATION_FORM
  DEFICIENCY_NOTICE
  CERTIFICATE
}

/// Every PDF the app issues (SPEC §7), stored with its SHA-256 so it can be re-downloaded and checked.
/// Belongs to one submission or one own-use notification. Never deleted; once stored, only
/// `supersededAt` may be set (DB trigger).
model GeneratedDocument {
  id                   String       @id @default(cuid())
  submissionId         String?
  ownUseNotificationId String?
  kind                 DocumentKind
  /// 1, 2, 3… per submission and kind.
  version              Int
  deficiencyNoticeId   String?
  fileName             String
  sha256               String
  sizeBytes            Int
  content              Bytes
  /// Why this version was made, e.g. "Reissued: change of address".
  note                 String?
  generatedById        String
  createdAt            DateTime     @default(now())
  /// Set when a newer version of the same document replaces this one.
  supersededAt         DateTime?

  submission         Submission?         @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  ownUseNotification OwnUseNotification? @relation(fields: [ownUseNotificationId], references: [id], onDelete: Restrict)
  deficiencyNotice   DeficiencyNotice?   @relation(fields: [deficiencyNoticeId], references: [id])
  generatedBy        User                @relation(fields: [generatedById], references: [id])

  @@unique([submissionId, kind, version])
  @@unique([ownUseNotificationId, kind, version])
  @@index([submissionId])
}

/// SPEC §1.2: one row per checklist item that has a value, by the form's shared document key; a
/// missing row is blank (pending). Rows for keys not on the current list are kept but not shown.
model DocumentChecklistItem {
  submissionId String
  documentKey  String
  value        CheckValue

  submission Submission @relation(fields: [submissionId], references: [id])

  @@id([submissionId, documentKey])
}

enum FinalDecision {
  REGISTER    @map("Register (13(1)(a))")
  DEFICIENCY  @map("Issue deficiency notice (13(1)(b))")
  REFUSE      @map("Refuse (13(3)) - after show-cause")
  LAPSE       @map("Treat as lapsed (13(2))")
  PROVISIONAL @map("Provisional registration (13(4))")
  REDIRECT    @map("Redirect to REG-01I / outside scope")
  /// Updates and annual confirmations (para 16).
  APPLY       @map("Accept filing and apply changes (para 16)")
}

/// SPEC §1.3: Form OGSERC/EVAL-01.
model Evaluation {
  id                    String         @id @default(cuid())
  submissionId          String         @unique
  evaluatingOfficerId   String?
  dateEvaluationStarted DateTime?      @db.Date
  reviewingSupervisorId String?
  approvingOfficerId    String?
  evaluationRemarks     String?
  finalDecision         FinalDecision?
  reasons               String?
  reviewDate            DateTime?      @db.Date
  approvalDate          DateTime?      @db.Date
  flagOverrideReason    String?
  updatedAt             DateTime       @updatedAt

  submission          Submission             @relation(fields: [submissionId], references: [id])
  evaluatingOfficer   User?                  @relation("EvaluatingOfficer", fields: [evaluatingOfficerId], references: [id])
  reviewingSupervisor User?                  @relation("ReviewingSupervisor", fields: [reviewingSupervisorId], references: [id])
  approvingOfficer    User?                  @relation("ApprovingOfficer", fields: [approvingOfficerId], references: [id])
  checks              EvaluationCheckValue[]
}

/// Manually entered check values; automatic checks are computed (SPEC §6), never stored.
model EvaluationCheckValue {
  evaluationId String
  checkId      String
  value        CheckValue

  evaluation Evaluation      @relation(fields: [evaluationId], references: [id])
  check      EvaluationCheck @relation(fields: [checkId], references: [id])

  @@id([evaluationId, checkId])
}

// ---------------------------------------------------------------------------
// Payments and own-use notifications
// ---------------------------------------------------------------------------

/// Finance confirmation of a payment. Only CONFIRMED payments count towards amounts paid.
enum PaymentFinanceStatus {
  PENDING
  CONFIRMED
  REJECTED
}

enum PaymentRecordStatus {
  ACTIVE
  /// Recorded in error; kept for the audit trail and excluded from totals.
  REVERSED
}

/// SPEC §1.4. Linked to exactly one Submission or OwnUseNotification via `reference`.
model Payment {
  id                   String               @id @default(cuid())
  paymentSeq           Int                  @unique
  paymentNo            String               @unique
  dateReceived         DateTime             @db.Date
  reference            String
  submissionId         String?
  ownUseNotificationId String?
  purpose              String?
  channel              String?
  amount               BigInt
  rrr                  String?
  verifiedWithBank     Boolean              @default(false)
  verifiedById         String?
  verifiedAt           DateTime?
  /// Finance decision: PENDING until a Finance officer (not the recorder) confirms or rejects it.
  financeStatus        PaymentFinanceStatus @default(PENDING)
  financeDecidedById   String?
  financeDecidedAt     DateTime?
  financeRemarks       String?
  status               PaymentRecordStatus  @default(ACTIVE)
  reversalReason       String?
  reversedById         String?
  reversedAt           DateTime?
  recordedById         String
  createdAt            DateTime             @default(now())

  submission         Submission?         @relation(fields: [submissionId], references: [id])
  ownUseNotification OwnUseNotification? @relation(fields: [ownUseNotificationId], references: [id])
  recordedBy         User                @relation("PaymentRecordedBy", fields: [recordedById], references: [id])
  verifiedBy         User?               @relation("PaymentVerifiedBy", fields: [verifiedById], references: [id])
  financeDecidedBy   User?               @relation("PaymentFinanceDecidedBy", fields: [financeDecidedById], references: [id])
  reversedBy         User?               @relation("PaymentReversedBy", fields: [reversedById], references: [id])

  @@index([reference])
  @@index([rrr])
  @@index([financeStatus])
}

/// SPEC §1.5: Category I, para 3(4), Form REG-01I. One per site.
model OwnUseNotification {
  id                   String   @id @default(cuid())
  ounSeq               Int      @unique
  ounNo                String   @unique
  name                 String
  dateFiled            DateTime @db.Date
  cacNo                String?
  siteAddress          String?
  lga                  String
  natureOfBusiness     String?
  gridConnected        Boolean?
  distributionLicensee String?
  contactPerson        String?
  phone                String?
  email                String?

  /// Registration with a certificate (setting "own-use certificate"). Locked once set (DB trigger).
  registrationNo       String?   @unique
  certificateIssueDate DateTime? @db.Date
  registeredById       String?
  flagOverrideReason   String?

  // Pricing snapshot taken at save (docs/DECISIONS.md); changes only via admin recalculation.
  pricedFee         BigInt
  pricedThresholdKw Int
  pricedAt          DateTime @default(now())

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy          User                 @relation(fields: [createdById], references: [id])
  registeredBy       User?                @relation("OwnUseRegisteredBy", fields: [registeredById], references: [id])
  units              OwnUseUnit[]
  documents          OwnUseDocumentItem[]
  payments           Payment[]
  generatedDocuments GeneratedDocument[]

  @@index([cacNo])
}

/// Generating units at the site (REG-01I Section C). Installed capacity is their sum.
model OwnUseUnit {
  id                   String   @id @default(cuid())
  ownUseNotificationId String
  sortOrder            Int
  makeModel            String?
  capacityKw           Decimal  @db.Decimal(12, 3)
  fuel                 String?
  avgMonthlyMwh        Decimal? @db.Decimal(12, 3)

  ownUseNotification OwnUseNotification @relation(fields: [ownUseNotificationId], references: [id])

  @@index([ownUseNotificationId])
}

/// REG-01I document checklist (by document key); a missing row is blank (pending).
model OwnUseDocumentItem {
  ownUseNotificationId String
  documentKey          String
  value                CheckValue

  ownUseNotification OwnUseNotification @relation(fields: [ownUseNotificationId], references: [id])

  @@id([ownUseNotificationId, documentKey])
}

/// Sign-in attempts, for the per-IP limit. Pruned after 7 days.
model LoginAttempt {
  id        BigInt   @id @default(autoincrement())
  ip        String
  email     String?
  success   Boolean
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

/// SPEC §1.6: append-only (UPDATE and DELETE are rejected by a trigger).
model AuditLog {
  id        BigInt   @id @default(autoincrement())
  timestamp DateTime @default(now())
  /// Null only for the scheduled system job.
  userId    String?
  action    String
  reference String?
  detail    String?

  user User? @relation(fields: [userId], references: [id])

  @@index([reference])
  @@index([timestamp])
}

/// In-app notice for one user that the workflow needs them (docs/DECISIONS.md, Notifications).
/// Written in the same transaction as the change it reports. Personal UI state, so reading one is
/// not audited.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  title     String
  body      String
  /// Page to open, inside the app.
  href      String
  /// Ack No., OUN No. or payment reference.
  reference String?
  createdAt DateTime  @default(now())
  readAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

/// A workbook uploaded for import (Phase 7). Kept permanently with its hash: the import is committed
/// from these exact bytes after staff review the preview. Never deleted; frozen once imported.
model WorkbookImport {
  id           String    @id @default(cuid())
  fileName     String
  sha256       String
  size         Int
  bytes        Bytes
  uploadedById String
  uploadedAt   DateTime  @default(now())
  importedById String?
  importedAt   DateTime?
  /// What was imported (counts), set with importedAt.
  summary      String?

  uploadedBy User  @relation("WorkbookUploadedBy", fields: [uploadedById], references: [id])
  importedBy User? @relation("WorkbookImportedBy", fields: [importedById], references: [id])

  @@index([sha256])
}
